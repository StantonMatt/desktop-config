#!/bin/sh

set -eu

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
screenshot_file=$(mktemp "$runtime_dir/quick-region-screenshot.XXXXXX.png")

cleanup() {
    rm -f "$screenshot_file"
}
trap cleanup EXIT HUP INT TERM

capture_mode=${1:---region}

if /usr/bin/spectacle "$capture_mode" --background --nonotify --output "$screenshot_file"; then
    QT_QPA_PLATFORM=xcb /usr/bin/python3 /home/mjstanton/.local/libexec/quick-region-clipboard.py "$screenshot_file" >/dev/null 2>&1 &
    trap - EXIT HUP INT TERM
fi
