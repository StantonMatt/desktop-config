[Desktop Entry]
Type=Application
Name=Quick Region Screenshot
Comment=Copy a selected screen region directly to the clipboard
Exec=/usr/bin/qdbus6 org.local.QuickRegionOverlay / org.local.QuickRegionOverlay.Capture
Icon=spectacle
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Utility;
X-KDE-Shortcuts=Meta+Shift+S
